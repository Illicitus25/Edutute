<resources>
    <style name="TextAppearance.Edutute.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Edutute.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Edutute.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/brand_text_secondary</item>
    </style>

    <style name="ShapeAppearance.Edutute.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>

    <style name="ShapeAppearance.Edutute.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/corner_md</item>
    </style>

    <style name="ShapeAppearance.Edutute.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/corner_lg</item>
    </style>

    <style name="Widget.Edutute.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/brand_text_primary</item>
        <item name="subtitleTextColor">@color/brand_text_secondary</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="navigationIconTint">@color/brand_text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>
    </style>

    <style name="Widget.Edutute.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/brand_surface_elevated</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/brand_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Large</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Edutute.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/brand_surface_elevated</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Large</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Edutute.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="iconTint">@color/brand_on_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Edutute.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/brand_primary_container</item>
        <item name="android:textColor">@color/brand_on_primary_container</item>
        <item name="iconTint">@color/brand_on_primary_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Edutute.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="iconTint">@color/brand_text_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Edutute.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="iconTint">@color/brand_text_primary</item>
        <item name="rippleColor">@color/brand_glow_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Edutute.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="backgroundTint">@color/attendance_segment_background</item>
        <item name="android:textColor">@color/attendance_segment_text</item>
        <item name="iconTint">@color/attendance_segment_text</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Edutute.Button.Segment.Compact" parent="Widget.Edutute.Button.Segment">
        <item name="android:minHeight">@dimen/button_height_compact</item>
    </style>

    <style name="Widget.Edutute.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/brand_error</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="iconTint">@color/brand_on_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Edutute.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/brand_surface_elevated</item>
        <item name="boxStrokeColor">@color/brand_outline</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="hintTextColor">@color/brand_text_secondary</item>
    </style>

    <style name="Widget.Edutute.Input.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/brand_surface_elevated</item>
        <item name="boxStrokeColor">@color/brand_outline</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="hintTextColor">@color/brand_text_secondary</item>
    </style>

    <style name="ThemeOverlay.Edutute.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Edutute.Large</item>
        <item name="colorSurface">@color/brand_surface</item>
    </style>

    <style name="ThemeOverlay.Edutute.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Edutute.BottomSheet</item>
    </style>

    <style name="Widget.Edutute.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:backgroundTint">@color/brand_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Edutute.Large</item>
    </style>

    <style name="Theme.Edutute.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/applogo</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/Theme.Edutute</item>
    </style>
</resources>
